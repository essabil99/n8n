# Save the real file outside the fork. Use docker compose --env-file /private/path/stack.env.
N8N_SANDBOX_VERSION=1.7.0
N8N_BIND_IP=127.0.0.1
N8N_PORT=5678
GENERIC_TIMEZONE=Africa/Casablanca
CHATGPT_PLAN_MODEL=gpt-6.1-sol
CHATGPT_AUTH_DIR=/absolute/private/path/chatgpt-auth
CHATGPT_BRIDGE_API_KEY=replace-with-a-random-secret-at-least-24-characters
N8N_ENCRYPTION_KEY=replace-with-a-random-persistent-secret
SANDBOX_API_KEY=replace-with-a-random-secret
SANDBOX_REGISTRATION_TOKEN=replace-with-a-random-secret
SANDBOX_RUNNER_KEY=replace-with-a-random-secret

CHATGPT_OAUTH_CODE_EXCHANGE=local-transfer
